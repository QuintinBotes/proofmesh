// The blog's schema, split across this folder.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  role    Role     @default(READER)
  posts   Post[]
  profile Profile?

  @@map("users")
  @@schema("auth")
}

model Profile {
  id     Int  @id
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  @@schema("auth")
}

enum Role {
  READER
  WRITER

  @@schema("auth")
}
