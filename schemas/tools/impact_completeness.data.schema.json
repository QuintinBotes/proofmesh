{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impact_completeness.data.schema.json",
  "title": "impact_completeness data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "head",
    "pending",
    "changed",
    "totals"
  ],
  "properties": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "snapshot_id"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null for the working tree."
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "snapshot_id"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null for the working tree."
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pending": {
      "type": "array",
      "description": "A side with no snapshot yet, and the index job started for it; while any is pending the answer lists nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "job_id"
        ],
        "properties": {
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null for the working tree."
          },
          "job_id": {
            "type": "string"
          }
        }
      }
    },
    "changed": {
      "type": "array",
      "description": "The changed symbols, by path and line: the innermost symbol of each changed line, a module when a top-level statement other than an import or export changed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "path",
          "line",
          "change",
          "status",
          "test",
          "dependents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "The declaration, in the base snapshot for a deleted symbol."
          },
          "change": {
            "enum": [
              "added",
              "modified",
              "deleted"
            ]
          },
          "status": {
            "enum": [
              "tested",
              "neither"
            ]
          },
          "test": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "line",
              "evidence",
              "basis",
              "depth",
              "changed"
            ],
            "description": "The nearest test that executes it, as find_tests lists it; null unless the status is tested.",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "evidence": {
                "enum": [
                  "call",
                  "transitive_call",
                  "dispatch",
                  "observed"
                ]
              },
              "basis": {
                "enum": [
                  "observed",
                  "inferred"
                ],
                "description": "observed: a compiler, an index or a declared configuration proves it. inferred: a convention, a name match or a contract match suggests it. Derived when the answer is built."
              },
              "depth": {
                "type": "integer",
                "minimum": 1
              },
              "changed": {
                "type": "boolean",
                "description": "The diff changes the test itself."
              },
              "key": {
                "type": "string",
                "description": "The stable_key of the test (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
              },
              "generated": {
                "type": "boolean",
                "description": "Present and true when the file is generated (FR292); absent otherwise."
              }
            }
          },
          "dependents": {
            "type": "array",
            "description": "By relation (calls, implements, overrides, inherits, references, imports), then path and line; from the base snapshot for a deleted symbol.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "path",
                "line",
                "relation",
                "via",
                "basis",
                "status",
                "test",
                "chain"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The site: the call, heritage clause, reference or import."
                },
                "relation": {
                  "enum": [
                    "calls",
                    "implements",
                    "overrides",
                    "inherits",
                    "references",
                    "imports"
                  ]
                },
                "via": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The member a dispatched call names, or the caller a caller of callers reaches the change through."
                },
                "basis": {
                  "enum": [
                    "observed",
                    "inferred"
                  ],
                  "description": "inferred when the chain that reaches the dependent has an inferred hop; a dependent an all-observed chain also reaches is observed."
                },
                "status": {
                  "enum": [
                    "changed",
                    "tested",
                    "neither"
                  ]
                },
                "test": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "path",
                    "line",
                    "evidence",
                    "basis",
                    "depth",
                    "changed"
                  ],
                  "description": "The nearest test that executes it, as find_tests lists it; null unless the status is tested.",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence": {
                      "enum": [
                        "call",
                        "transitive_call",
                        "dispatch",
                        "observed"
                      ]
                    },
                    "basis": {
                      "enum": [
                        "observed",
                        "inferred"
                      ],
                      "description": "observed: a compiler, an index or a declared configuration proves it. inferred: a convention, a name match or a contract match suggests it. Derived when the answer is built."
                    },
                    "depth": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "changed": {
                      "type": "boolean",
                      "description": "The diff changes the test itself."
                    },
                    "key": {
                      "type": "string",
                      "description": "The stable_key of the test (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
                    },
                    "generated": {
                      "type": "boolean",
                      "description": "Present and true when the file is generated (FR292); absent otherwise."
                    }
                  }
                },
                "key": {
                  "type": "string",
                  "description": "The stable_key of the dependent; absent for an importing file (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
                },
                "generated": {
                  "type": "boolean",
                  "description": "Present and true when the file is generated (FR292); absent otherwise."
                },
                "chain": {
                  "type": "array",
                  "description": "How the dependent reaches the change (FR1811): from the dependent at its call, import or reference site, through each caller or member it reaches the change through, to the changed symbol at its declaration, in the snapshot the row is from.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "path",
                      "line"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "The site of the relationship to the next hop; for the last hop, the changed symbol's declaration."
                      },
                      "generated": {
                        "type": "boolean",
                        "description": "Present and true when the file is generated (FR292); absent otherwise."
                      },
                      "key": {
                        "type": "string",
                        "description": "The stable_key of the symbol at this hop (FR280)."
                      },
                      "assertion_id": {
                        "type": "string",
                        "description": "The relationship from this hop to the next, as get_relationships and read_evidence name it; absent on the last hop, the changed symbol at its declaration."
                      }
                    }
                  }
                }
              }
            }
          },
          "key": {
            "type": "string",
            "description": "The stable_key of the changed symbol (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
          },
          "generated": {
            "type": "boolean",
            "description": "Present and true when the file is generated (FR292); absent otherwise."
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_symbols",
        "dependents",
        "changed",
        "tested",
        "neither",
        "by_basis"
      ],
      "description": "Over every changed symbol, on this page or not; changed, tested and neither count the dependents.",
      "properties": {
        "changed_symbols": {
          "type": "integer",
          "minimum": 0
        },
        "dependents": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "tested": {
          "type": "integer",
          "minimum": 0
        },
        "neither": {
          "type": "integer",
          "minimum": 0
        },
        "by_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed",
            "inferred"
          ],
          "description": "The dependents by basis; unresolved boundaries have none.",
          "properties": {
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "inferred": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
