{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace_status.data.schema.json",
  "title": "workspace_status data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "adapters",
    "files",
    "languages",
    "hubs",
    "calls",
    "file_summary",
    "analysis"
  ],
  "properties": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "git"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^repo_[0-9a-z]+$"
        },
        "name": {
          "type": "string"
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "head": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "behind_remote": {
              "type": [
                "integer",
                "null"
              ]
            },
            "behind_ref": {
              "type": [
                "string",
                "null"
              ],
              "description": "The remote branch behind_remote counts against, such as origin/main; null when the repository has no remote default branch."
            },
            "fetched_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When that remote branch was last fetched; behind_remote is only as current as this."
            }
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "protocol_version",
          "languages"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "protocol_version": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "disposition",
          "detail",
          "language",
          "capabilities"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "indexed",
              "excluded_by_rule",
              "unsupported",
              "failed",
              "pending"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "complete",
                "partial",
                "unsupported",
                "failed",
                "not_run"
              ]
            },
            "properties": {
              "tier": {
                "type": "string",
                "description": "The tier that produced the file's facts: precise:<adapter>, scip:<index> or syntax. Absent on files no adapter analysed."
              },
              "generated": {
                "const": "true",
                "description": "Present on a generated file: indexed like any other and flagged (FR292)."
              }
            }
          },
          "generated": {
            "type": "boolean",
            "description": "Present and true when the file is generated (FR292); absent otherwise."
          }
        }
      },
      "description": "File rows, only when the input asks for them with files; otherwise empty, and file_summary says what the snapshot holds."
    },
    "hubs": {
      "type": "array",
      "maxItems": 12,
      "description": "The most-referenced symbols by resolved inbound relationships, as starting points for exploration.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "qualified_name",
          "path",
          "inbound"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qualified_name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "inbound": {
            "type": "integer",
            "minimum": 1
          },
          "key": {
            "type": "string",
            "description": "The stable_key of the hub (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
          },
          "generated": {
            "type": "boolean",
            "description": "Present and true when the file is generated (FR292); absent otherwise."
          }
        }
      }
    },
    "module_cycles": {
      "type": "array",
      "description": "Cycles among build modules that syntax-tier name matches form, in an ecosystem whose builds forbid them (Maven, Gradle, Go modules, Cargo, .NET); empty when there is none. Each names its modules and the edges that form it, with one site of each.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "modules",
          "edges"
        ],
        "properties": {
          "ecosystem": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "type",
                "sites",
                "path",
                "line",
                "assertion_id"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "sites": {
                  "type": "integer",
                  "minimum": 1
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "assertion_id": {
                  "type": "string"
                },
                "generated": {
                  "type": "boolean",
                  "description": "Present and true when the file is generated (FR292); absent otherwise."
                }
              }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "description": "Index jobs of the repository that are queued or running, from MCP or the CLI, oldest first; poll one with get_job.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_id",
          "state",
          "requested_by",
          "requested_at",
          "started_at",
          "finished_at",
          "phase",
          "done",
          "total",
          "result",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "repository_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "interrupted"
            ]
          },
          "requested_by": {
            "type": "string"
          },
          "requested_at": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "done": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the job last reported progress: a running job whose progress_at stops moving is stuck, not slow."
          },
          "phase_started_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the current phase began."
          },
          "plan": {
            "description": "Per adapter: incremental or full, how many files it re-analyses and how many replay cached facts; null until analysis starts.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "analyse",
                    "reuse"
                  ],
                  "properties": {
                    "mode": {
                      "enum": [
                        "incremental",
                        "full"
                      ]
                    },
                    "analyse": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reuse": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          },
          "elapsed_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Since the job started, or its whole run once finished."
          }
        }
      }
    },
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sites",
        "unresolved",
        "by_reason"
      ],
      "description": "Call sites in the snapshot, how many are unresolved, and why.",
      "properties": {
        "sites": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "dependency_missing_by_package": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "dependency_missing call sites per package their project lacks, the 20 largest: a site counts once under each package its project lacks."
        }
      }
    },
    "file_summary": {
      "type": "array",
      "description": "Files by disposition, reason and extension, largest group first: what was indexed, excluded or unsupported, without a row per file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition",
          "detail",
          "extension",
          "files"
        ],
        "properties": {
          "disposition": {
            "enum": [
              "indexed",
              "excluded_by_rule",
              "unsupported",
              "failed",
              "pending"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "extension": {
            "type": "string",
            "description": "The file name's extension with its dot, or the whole name when it has none."
          },
          "files": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "description": "The language census (FR136): every discovered file in exactly one row, code and template kinds first, then by file count, then by name. Each row says which tier read the language, how deep it goes, why it stops there and what a person can do about it. Empty for a snapshot sealed before the census existed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "kind",
          "files",
          "dispositions",
          "excluded",
          "tier",
          "tiers",
          "capabilities",
          "reason",
          "remedy"
        ],
        "properties": {
          "language": {
            "type": "string",
            "description": "The language by Linguist's name, `unknown` for a file no rule names (see extension), or `binary`."
          },
          "kind": {
            "enum": [
              "code",
              "template",
              "data",
              "prose",
              "unknown",
              "binary"
            ]
          },
          "extension": {
            "type": "string",
            "description": "Only on `unknown` rows: the extension with its dot, or the whole file name when it has none."
          },
          "files": {
            "type": "integer",
            "minimum": 1
          },
          "dispositions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "indexed",
              "excluded",
              "unsupported",
              "failed"
            ],
            "properties": {
              "indexed": {
                "type": "integer",
                "minimum": 0
              },
              "excluded": {
                "type": "integer",
                "minimum": 0
              },
              "unsupported": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "excluded": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Files left out by rule, counted by the rule that left them out."
          },
          "tier": {
            "type": "string",
            "description": "The tier that read most of the files not excluded: precise:<adapter>, scip:<index>, syntax, or none."
          },
          "tiers": {
            "type": "array",
            "description": "Every tier that read files of this language, or none for files nothing read, with its file count; excluded files are in none of them.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tier",
                "files"
              ],
              "properties": {
                "tier": {
                  "type": "string"
                },
                "files": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbols",
              "imports",
              "references",
              "resolved_calls"
            ],
            "description": "For each capability, the count of the row's files at each level; each capability's counts sum to files.",
            "properties": {
              "symbols": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "complete",
                  "partial",
                  "unsupported",
                  "failed",
                  "not_run"
                ],
                "properties": {
                  "complete": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "partial": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unsupported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_run": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "imports": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "complete",
                  "partial",
                  "unsupported",
                  "failed",
                  "not_run"
                ],
                "properties": {
                  "complete": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "partial": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unsupported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_run": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "references": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "complete",
                  "partial",
                  "unsupported",
                  "failed",
                  "not_run"
                ],
                "properties": {
                  "complete": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "partial": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unsupported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_run": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "resolved_calls": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "complete",
                  "partial",
                  "unsupported",
                  "failed",
                  "not_run"
                ],
                "properties": {
                  "complete": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "partial": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unsupported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_run": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the weakest files stop where they do: no_precise_tier, no_grammar, not_code, adapter_unavailable:<id>, adapter_changed:<id>, scip_stale:<index>, scip_revoked:<index>:<grant>, unknown_language, binary, excluded, or a failure detail; null when nothing holds the row back."
          },
          "remedy": {
            "type": [
              "string",
              "null"
            ],
            "description": "Advice only: what a person can do to deepen the row. The census runs nothing and installs nothing."
          },
          "generated": {
            "type": "integer",
            "minimum": 0,
            "description": "Files of this language flagged generated, already counted in files (FR297). Absent on a snapshot sealed before the policy."
          },
          "vendored": {
            "type": "integer",
            "minimum": 0,
            "description": "Files of this language left out as vendored, already counted in files (FR297). Absent on a snapshot sealed before the policy."
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "config",
        "generated_sources",
        "dependencies",
        "generated_policy"
      ],
      "description": "How the snapshot was analysed (FR004): discovery's rules, what happens to generated source, and each adapter's external inputs.",
      "properties": {
        "mode": {
          "enum": [
            "no_execution",
            "trusted_build"
          ]
        },
        "config": {
          "description": "The discovery rules the snapshot was built with (excluded directories, the size limit for indexed files, symlinks, ignore files); null for a snapshot built before it was recorded.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "generated_sources": {
          "type": "string",
          "description": "The generated-source policy of the analysis mode."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adapter",
              "analysis_mode",
              "inputs_read",
              "inputs_missing",
              "missing"
            ],
            "properties": {
              "adapter": {
                "type": "string"
              },
              "analysis_mode": {
                "type": "string"
              },
              "inputs_read": {
                "type": "integer",
                "minimum": 0
              },
              "inputs_missing": {
                "type": "integer",
                "minimum": 0
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Up to 20 missing external inputs."
              }
            }
          }
        },
        "generated_policy": {
          "type": [
            "object",
            "null"
          ],
          "description": "The generated and vendored code policy (FR296): the markers, attributes and paths used, and what is done with each kind of file. The policy the snapshot was built with; null for a snapshot sealed before it was recorded.",
          "additionalProperties": true
        }
      }
    }
  }
}
