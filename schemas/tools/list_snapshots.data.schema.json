{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "list_snapshots.data.schema.json",
  "title": "list_snapshots data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository_id",
    "snapshots"
  ],
  "properties": {
    "repository_id": {
      "type": "string"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "published_at",
          "analysis_mode",
          "current",
          "matches_head",
          "git",
          "symbols",
          "relationships",
          "unresolved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "analysis_mode": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "matches_head": {
            "description": "Whether the snapshot's commit is the commit the repository root's HEAD names now: false when it is another commit, null when either commit is unknown (no git, or the root is missing). Uncommitted changes are not compared.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "git": {
            "description": "The git facts recorded with the snapshot, or null.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "symbols": {
            "description": "Symbols in the snapshot, as compare_snapshots counts a side; null when its sealed file cannot be read.",
            "type": [
              "integer",
              "null"
            ]
          },
          "relationships": {
            "description": "Relationships in the snapshot, as compare_snapshots counts a side; null when its sealed file cannot be read.",
            "type": [
              "integer",
              "null"
            ]
          },
          "unresolved": {
            "description": "Relationships that are neither resolved nor resolved to an external symbol; null when its sealed file cannot be read.",
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
