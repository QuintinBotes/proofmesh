{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_symbol.data.schema.json",
  "title": "get_symbol data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol"
  ],
  "properties": {
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "qualified_name",
        "path",
        "start_line",
        "end_line",
        "signature",
        "evidence_id",
        "stable_key",
        "body_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sym_[0-9a-z]+$"
        },
        "kind": {
          "enum": [
            "function",
            "class",
            "method",
            "interface",
            "type_alias",
            "variable",
            "module",
            "struct",
            "enum",
            "property",
            "field",
            "constructor",
            "namespace",
            "project",
            "package",
            "endpoint",
            "table",
            "message",
            "channel",
            "job",
            "feature_flag",
            "config_key",
            "team",
            "service"
          ]
        },
        "name": {
          "type": "string"
        },
        "qualified_name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer"
        },
        "end_line": {
          "type": "integer"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[0-9a-z]+$"
        },
        "stable_key": {
          "type": "string",
          "description": "path#qualified_name#kind, as this snapshot stores it."
        },
        "body_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the declaration text with line endings, common indentation, trailing whitespace and the symbol's own name normalised (a module: its file text); null when the span is no more than the name, or the snapshot was sealed before hashes existed."
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "test",
              "test_support"
            ]
          },
          "description": "The roles the adapter gave the symbol, when it gave any: test (a test entry point) or test_support (test code that is no entry point)."
        },
        "generated": {
          "type": "boolean",
          "description": "Present and true when the file is generated (FR292); absent otherwise."
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scip": {
              "type": "string",
              "description": "The SCIP index's own symbol for this definition, as the index wrote it (FR441)."
            }
          },
          "description": "What the adapter recorded beside the symbol's name, when it recorded any: scip, the SCIP index's own symbol for a definition the SCIP importer declared (FR441). Absent when the adapter sent none (no built-in adapter but the SCIP importer sends it), and in a snapshot sealed before format 0.11."
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "lines_covered",
        "lines_total",
        "source",
        "format",
        "window",
        "stale",
        "at"
      ],
      "description": "Present only in the full envelope and only when an imported coverage report covers the subject's file (#241): what the newest import of that file that is not stale says of the lines whose innermost symbol is the subject, or the newest stale one when every import is stale.",
      "properties": {
        "executed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true when at least one of the subject's executable lines has a hit; null when the coverage is stale."
        },
        "lines_covered": {
          "type": "integer",
          "minimum": 0
        },
        "lines_total": {
          "type": "integer",
          "minimum": 0,
          "description": "The subject's executable lines in the report."
        },
        "source": {
          "type": "string",
          "description": "The import's --source label."
        },
        "format": {
          "enum": [
            "lcov",
            "cobertura",
            "jacoco",
            "go-cover"
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          }
        },
        "stale": {
          "type": "boolean",
          "description": "true when the file's content in this snapshot differs from the content at import; stale coverage sets no status."
        },
        "at": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "path",
            "line"
          ],
          "description": "The first executed line of the subject; null when none is or the coverage is stale.",
          "properties": {
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
