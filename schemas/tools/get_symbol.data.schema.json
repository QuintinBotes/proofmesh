{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_symbol.data.schema.json",
  "title": "get_symbol data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol"
  ],
  "properties": {
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "qualified_name",
        "path",
        "start_line",
        "end_line",
        "signature",
        "evidence_id",
        "stable_key",
        "body_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sym_[0-9a-z]+$"
        },
        "kind": {
          "enum": [
            "function",
            "class",
            "method",
            "interface",
            "type_alias",
            "variable",
            "module",
            "struct",
            "enum",
            "property",
            "field",
            "constructor",
            "namespace",
            "project",
            "package",
            "endpoint",
            "table",
            "message",
            "channel",
            "job",
            "feature_flag",
            "config_key",
            "team",
            "service"
          ]
        },
        "name": {
          "type": "string"
        },
        "qualified_name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer"
        },
        "end_line": {
          "type": "integer"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[0-9a-z]+$"
        },
        "stable_key": {
          "type": "string",
          "description": "path#qualified_name#kind, as this snapshot stores it."
        },
        "body_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the declaration text with line endings, common indentation, trailing whitespace and the symbol's own name normalised (a module: its file text); null when the span is no more than the name, or the snapshot was sealed before hashes existed."
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "test",
              "test_support"
            ]
          },
          "description": "The roles the adapter gave the symbol, when it gave any: test (a test entry point) or test_support (test code that is no entry point)."
        },
        "generated": {
          "type": "boolean",
          "description": "Present and true when the file is generated (FR292); absent otherwise."
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scip": {
              "type": "string",
              "description": "The SCIP index's own symbol for this definition, as the index wrote it (FR441)."
            }
          },
          "description": "What the adapter recorded beside the symbol's name, when it recorded any: scip, the SCIP index's own symbol for a definition the SCIP importer declared (FR441). Absent otherwise, and in a snapshot sealed before format 0.11."
        }
      }
    }
  }
}
