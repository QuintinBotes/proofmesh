{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_job.data.schema.json",
  "title": "get_job data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job"
  ],
  "properties": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository_id",
        "state",
        "requested_by",
        "requested_at",
        "started_at",
        "finished_at",
        "phase",
        "done",
        "total",
        "result",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "interrupted"
          ]
        },
        "requested_by": {
          "type": "string"
        },
        "requested_at": {
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "done": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "When the job last reported progress: a running job whose progress_at stops moving is stuck, not slow."
        },
        "phase_started_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "When the current phase began."
        },
        "plan": {
          "description": "Per adapter: incremental or full, how many files it re-analyses and how many replay cached facts, and the memory budget it runs under; null until analysis starts.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "analyse",
                  "reuse"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "incremental",
                      "full"
                    ]
                  },
                  "analyse": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reuse": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "budget_mb": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The memory budget of the adapter's process, in MB."
                  },
                  "budget_source": {
                    "enum": [
                      "setting",
                      "machine"
                    ],
                    "description": "Whether an explicit setting or half of the machine's memory (8 to 32 GB) chose the budget."
                  }
                }
              }
            }
          ]
        },
        "adapters": {
          "description": "Per running adapter, refreshed at least every 5 seconds while it analyses: its languages, files done and total, files a second, and the seconds left (null until a file is done). Never holds source text.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "adapter",
                  "language",
                  "done",
                  "total",
                  "files_per_second",
                  "eta_seconds"
                ],
                "properties": {
                  "adapter": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "done": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "files_per_second": {
                    "type": "number",
                    "minimum": 0
                  },
                  "eta_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          ]
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Since the job started, or its whole run once finished."
        }
      }
    }
  }
}
