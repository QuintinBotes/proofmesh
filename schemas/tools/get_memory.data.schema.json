{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_memory.data.schema.json",
  "title": "get_memory data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notes",
    "total"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "status",
          "target",
          "refs",
          "missing_refs",
          "staleness",
          "accepted_by",
          "accepted_at",
          "sources",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "staleness": {
            "enum": [
              "current",
              "changed",
              "unaccepted"
            ]
          },
          "accepted_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "accepted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "body": {
            "type": "string"
          }
        }
      }
    }
  }
}
