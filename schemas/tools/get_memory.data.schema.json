{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_memory.data.schema.json",
  "title": "get_memory data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notes",
    "total"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "status",
          "target",
          "refs",
          "missing_refs",
          "ambiguous_refs",
          "staleness",
          "accepted_by",
          "accepted_at",
          "sources",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ambiguous_refs": {
            "type": "array",
            "description": "References that match several symbols, each with the stable_key of every match (FR150): the note does not say which one it means, so it is not current.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "keys"
              ],
              "properties": {
                "ref": {
                  "type": "string"
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "staleness": {
            "enum": [
              "current",
              "changed",
              "tier_changed",
              "ambiguous",
              "unaccepted"
            ],
            "description": "unaccepted: no person has accepted the note. ambiguous: a reference matches several symbols. tier_changed: a referenced file was analysed by another tier (an index was named, went stale or a precise adapter appeared) and its content did not change (FR150). changed: the relationships of the referenced symbols moved. current otherwise."
          },
          "accepted_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "accepted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "body": {
            "type": "string"
          }
        }
      }
    }
  }
}
