{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/compare_snapshots.data.schema.json",
  "title": "compare_snapshots data",
  "description": "What changed between two sealed snapshots of one repository, matched by qualified name and kind for symbols, then a removed and an added symbol of equal kind and body hash paired as moved or renamed, and by path for files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["base", "head", "symbols", "relationships", "files"],
  "properties": {
    "base": { "$ref": "#/$defs/side" },
    "head": { "$ref": "#/$defs/side" },
    "symbols": {
      "type": "object", "additionalProperties": false, "required": ["added", "removed", "changed", "paired", "ambiguous", "counts"],
      "properties": {
        "counts": { "type": "object", "additionalProperties": false, "required": ["added", "removed", "changed", "paired", "ambiguous"], "properties": { "added": { "type": "integer" }, "removed": { "type": "integer" }, "changed": { "type": "integer" }, "paired": { "type": "integer" }, "ambiguous": { "type": "integer" } } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
        "changed": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/symbol" }, { "type": "object", "required": ["what"], "properties": { "what": { "type": "array", "items": { "enum": ["signature", "range", "path", "body"] } }, "base_id": { "type": "string" }, "base_stable_key": { "type": "string" }, "base_body_hash": { "type": ["string", "null"] } } }] } },
        "paired": { "type": "array", "description": "One removed and one added symbol of the same kind and body hash. The change is moved (the file differs), renamed (the name differs) or moved_renamed.", "items": { "type": "object", "additionalProperties": false, "required": ["change", "kind", "body_hash", "base", "head"], "properties": { "change": { "enum": ["moved", "renamed", "moved_renamed"] }, "kind": { "type": "string" }, "body_hash": { "type": "string" }, "base": { "$ref": "#/$defs/symbol" }, "head": { "$ref": "#/$defs/symbol" } } } },
        "ambiguous": { "type": "array", "description": "Removed and added symbols of one kind and body hash that are not one on each side, or have the same file and name: candidates, never a guess. They stay in removed and added.", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "body_hash", "removed", "added"], "properties": { "kind": { "type": "string" }, "body_hash": { "type": "string" }, "removed": { "type": "array", "items": { "$ref": "#/$defs/symbol" } }, "added": { "type": "array", "items": { "$ref": "#/$defs/symbol" } } } } }
      }
    },
    "relationships": {
      "type": "object", "additionalProperties": false, "required": ["added", "removed", "by_type"],
      "properties": {
        "added": { "type": "integer" }, "removed": { "type": "integer" },
        "by_type": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["added", "removed"], "properties": { "added": { "type": "integer" }, "removed": { "type": "integer" } } } }
      }
    },
    "files": {
      "type": "object", "additionalProperties": false, "required": ["added", "removed", "changed", "disposition_changes"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } }, "removed": { "type": "array", "items": { "type": "string" } }, "changed": { "type": "array", "items": { "type": "string" } },
        "disposition_changes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "from", "to"], "properties": { "path": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" } } } }
      }
    }
  },
  "$defs": {
    "side": { "type": "object", "additionalProperties": false, "required": ["snapshot_id", "published_at", "symbols", "relationships", "unresolved"], "properties": { "snapshot_id": { "type": "string" }, "published_at": { "type": "string" }, "symbols": { "type": "integer" }, "relationships": { "type": "integer" }, "unresolved": { "type": "integer" } } },
    "symbol": { "type": "object", "additionalProperties": true, "required": ["id", "qualified_name", "kind", "path", "stable_key", "body_hash"], "properties": { "id": { "type": "string" }, "stable_key": { "type": "string" }, "body_hash": { "type": ["string", "null"], "description": "Null when the span is no more than the name, or the snapshot was sealed before hashes existed." }, "qualified_name": { "type": "string" }, "kind": { "type": "string" }, "path": { "type": "string" } } }
  }
}
