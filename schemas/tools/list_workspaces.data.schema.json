{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "list_workspaces.data.schema.json",
  "title": "list_workspaces data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaces"
  ],
  "properties": {
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository_id",
                "name"
              ],
              "properties": {
                "repository_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
