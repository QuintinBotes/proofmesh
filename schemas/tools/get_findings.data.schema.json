{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/get_findings.data.schema.json",
  "title": "get_findings data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "imports",
    "total"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "import",
          "tool",
          "rule",
          "level",
          "message",
          "path",
          "line",
          "end_line",
          "rank",
          "precision",
          "symbol",
          "stale"
        ],
        "properties": {
          "import": {
            "type": "string",
            "description": "The name the SARIF file was imported under."
          },
          "tool": {
            "type": "string",
            "description": "The run's tool and version, as the SARIF file names them."
          },
          "rule": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "description": "The SARIF level: error, warning, note or none (warning when the file gives none)."
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The finding's start line; null when the SARIF result names its file only."
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rank": {
            "type": [
              "number",
              "null"
            ],
            "description": "SARIF rank, 0 to 100, when the tool gave one."
          },
          "precision": {
            "type": [
              "string",
              "null"
            ],
            "description": "The rule's precision property (CodeQL's @precision), when the tool gave one."
          },
          "symbol": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "name",
                  "qualified_name"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "qualified_name": {
                    "type": "string"
                  }
                }
              }
            ],
            "description": "The innermost symbol whose span holds the line, or the file's module when none does (get_symbols_at)."
          },
          "stale": {
            "type": [
              "string",
              "null"
            ],
            "description": "sarif_stale:<import> when the file's content in this snapshot is not what it was when the SARIF file was imported; null otherwise."
          },
          "code_flow": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total_steps": {
                "type": "integer",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "flow": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "thread": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "step": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "uri": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "end_line": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "column": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "end_column": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "verified",
                        "stale",
                        "outside_repository",
                        "not_in_snapshot",
                        "no_position",
                        "unavailable",
                        "failed",
                        "unresolved_location"
                      ]
                    },
                    "object_hash": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "source_line": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "line_truncated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "flow",
                    "thread",
                    "step",
                    "uri",
                    "path",
                    "line",
                    "end_line",
                    "column",
                    "end_column",
                    "status",
                    "object_hash",
                    "source_line",
                    "line_truncated"
                  ]
                }
              }
            },
            "required": [
              "total_steps",
              "truncated",
              "steps"
            ]
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tools",
          "findings",
          "unattached",
          "added_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "integer",
            "minimum": 0
          },
          "unattached": {
            "type": "integer",
            "minimum": 0,
            "description": "Results left out at import: outside the repository, in a file not in the snapshot, or with no location."
          },
          "added_at": {
            "type": "string"
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Findings that match, before max_rows."
    }
  },
  "description": "Imported SARIF findings by path and line (FR1902)."
}
