{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_overview.data.schema.json",
  "title": "get_overview data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "scope",
    "children",
    "links",
    "omitted"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "directory",
        "file"
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "kind",
          "symbols",
          "matches",
          "symbol_kind"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "directory",
              "file",
              "symbol"
            ]
          },
          "symbols": {
            "type": "integer",
            "minimum": 0
          },
          "matches": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "symbol_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_key": {
            "type": "string",
            "description": "The stable_key of a symbol child (key is its id) (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "count",
          "by_type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "by_type": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "omitted": {
      "type": "integer",
      "minimum": 0
    },
    "generated": {
      "type": "boolean",
      "description": "Present and true when the file is generated (FR292); absent otherwise."
    }
  }
}
