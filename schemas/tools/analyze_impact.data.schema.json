{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyze_impact.data.schema.json",
  "title": "analyze_impact data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subjects",
    "types",
    "dependents",
    "totals",
    "stopped_by",
    "subject_members"
  ],
  "properties": {
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "qualified_name",
          "path",
          "project",
          "depth",
          "basis",
          "line",
          "relationship"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qualified_name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "The line in path of the relationship that first reached the dependent (for a call, its call site); its declaration line when dispatch alone reached it or that relationship is recorded in another file, which site then names."
          },
          "relationship": {
            "type": "string",
            "description": "That relationship's type (calls, implements, imports and so on), or dispatch when the dependent was reached only as an implementation or override of a member the walk reached."
          },
          "depth": {
            "type": "integer",
            "minimum": 1
          },
          "basis": {
            "enum": [
              "observed",
              "inferred"
            ],
            "description": "inferred when the strongest chain to the dependent has an inferred hop; the strongest chain is the shortest all-observed chain where one exists, and depth is that chain's."
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "site": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "start_line"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "generated": {
                "type": "boolean",
                "description": "Present and true when the file is generated (FR292); absent otherwise."
              }
            },
            "description": "Where the relationship that first reached the dependent is recorded, when that is not in path: a registration in another file, say (FR860). For a file reached through imports (kind file): the import statement that reached it."
          },
          "generated": {
            "type": "boolean",
            "description": "Present and true when the file is generated (FR292); absent otherwise."
          },
          "key": {
            "type": "string",
            "description": "The stable_key of the dependent (FR280): the key every tool takes as `key`, unique in the snapshot and the same in every tier. Absent when the id is no symbol, such as a file."
          },
          "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "commit"
            ],
            "description": "Present on a row of another repository of the workspace (include_workspace): that repository, and the commit its snapshot was built from. Its ids and evidence ids are of that snapshot.",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependents",
        "by_basis",
        "by_depth",
        "by_project",
        "by_area",
        "by_team"
      ],
      "properties": {
        "dependents": {
          "type": "integer",
          "minimum": 0
        },
        "by_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed",
            "inferred"
          ],
          "description": "The dependents by basis; unresolved boundaries have none.",
          "properties": {
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "inferred": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_depth": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_project": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "count"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "by_area": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "count"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "by_team": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "count"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "stopped_by": {
      "enum": [
        "max_depth",
        "node_budget",
        null
      ]
    },
    "subject_members": {
      "type": "integer",
      "minimum": 0,
      "description": "Members nested in type subjects, included as starting points because calls reach a type through them."
    },
    "workspace": {
      "type": "array",
      "description": "With include_workspace: each workspace that holds this repository, its link file (null when none is sealed), and each member's side of it: the snapshot and commit the link file was built from, and whether that snapshot is still the member's current one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "link_file_id",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "link_file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "commit",
                "snapshot_id",
                "current"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "snapshot_id": {
                  "type": "string"
                },
                "current": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
