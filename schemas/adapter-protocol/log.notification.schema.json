{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log.notification.schema.json",
  "title": "log.notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "message"
  ],
  "properties": {
    "level": {
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}
