#!/bin/sh
# A stand-in for the GitHub CLI: logs every argv line to $GH_LOG and answers from $GH_ANSWERS (JSON keyed by the search term).
printf '%s\n' "$*" >> "$GH_LOG"
if [ "$1" = "repo" ] && [ "$2" = "clone" ]; then mkdir -p "$4/.git" && printf '%s\n' "$3" > "$4/CLONED"; exit 0; fi
if [ "$1" = "search" ]; then node -e 'const a=JSON.parse(require("fs").readFileSync(process.env.GH_ANSWERS,"utf8"));process.stdout.write(JSON.stringify(a[process.argv[1]]??[]))' "$3"; exit 0; fi
if [ "$1" = "api" ]; then node -e 'const a=JSON.parse(require("fs").readFileSync(process.env.GH_ANSWERS,"utf8"));const r=a[process.argv[1]];if(!r){process.stderr.write("HTTP 404");process.exit(1)}process.stdout.write(JSON.stringify(r))' "$2"; exit $?; fi
echo "fake gh: unexpected $*" >&2; exit 1
