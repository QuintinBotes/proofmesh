# The CLI entry point is source, not a .NET build output.
!/packages/proofmesh/bin/
/bench/results/
# Graph benchmark: ProofMesh's data directory and every generated result (truth.json alone is ~40 MB).
/.bench-data/
/bench/graph-bench/out/
# Parity benchmark (bench/parity): every result, ProofMesh's data directory and the SCIP index of the fixture.
/bench/parity/out/

# Release artifacts are built locally and never committed.
/release/out/

# Claude Code writes this when it loads the plugin with --plugin-dir, for the mods types of its own build.
/packages/proofmesh-plugin/tsconfig.json
