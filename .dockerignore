!tsconfig.base.json
!global.json
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!packages/
!adapters/
!apps/
!schemas/
!policy/licenses.json
**/node_modules
adapters/**/bin
**/obj
**/dist
**/TestResults
**/test-results
**/.DS_Store
